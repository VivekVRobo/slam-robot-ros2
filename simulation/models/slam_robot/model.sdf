<?xml version="1.0"?>
<sdf version="1.10">
  <model name="slam_robot">
    <pose>0 0 0 0 0 0</pose><self_collide>false</self_collide>
    <link name="base_footprint"><inertial><pose>0 0 0.073 0 0 0</pose><mass>2.2</mass><inertia><ixx>0.014</ixx><iyy>0.021</iyy><izz>0.031</izz></inertia></inertial><collision name="base_collision"><pose>0 0 0.073 0 0 0</pose><geometry><box><size>0.30 0.24 0.08</size></box></geometry><surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface></collision><visual name="base_visual"><pose>0 0 0.073 0 0 0</pose><geometry><box><size>0.30 0.24 0.08</size></box></geometry><material><ambient>0.10 0.25 0.75 1</ambient><diffuse>0.12 0.32 0.9 1</diffuse></material></visual></link>
    <link name="left_wheel"><pose>0 0.13 0.033 1.57079632679 0 0</pose><inertial><mass>0.12</mass><inertia><ixx>0.00005</ixx><iyy>0.00005</iyy><izz>0.00008</izz></inertia></inertial><collision name="collision"><geometry><cylinder><radius>0.033</radius><length>0.025</length></cylinder></geometry><surface><friction><ode><mu>1.0</mu><mu2>0.02</mu2><fdir1>1 0 0</fdir1></ode></friction></surface></collision><visual name="visual"><geometry><cylinder><radius>0.033</radius><length>0.025</length></cylinder></geometry></visual></link>
    <joint name="left_wheel_joint" type="revolute"><parent>base_footprint</parent><child>left_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
    <link name="right_wheel"><pose>0 -0.13 0.033 1.57079632679 0 0</pose><inertial><mass>0.12</mass><inertia><ixx>0.00005</ixx><iyy>0.00005</iyy><izz>0.00008</izz></inertia></inertial><collision name="collision"><geometry><cylinder><radius>0.033</radius><length>0.025</length></cylinder></geometry><surface><friction><ode><mu>1.0</mu><mu2>0.02</mu2><fdir1>1 0 0</fdir1></ode></friction></surface></collision><visual name="visual"><geometry><cylinder><radius>0.033</radius><length>0.025</length></cylinder></geometry></visual></link>
    <joint name="right_wheel_joint" type="revolute"><parent>base_footprint</parent><child>right_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
    <link name="caster"><pose>-0.105 0 0.015 0 0 0</pose><inertial><mass>0.04</mass><inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz></inertia></inertial><collision name="collision"><geometry><sphere><radius>0.015</radius></sphere></geometry><surface><friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction></surface></collision><visual name="visual"><geometry><sphere><radius>0.015</radius></sphere></geometry></visual></link>
    <joint name="caster_joint" type="ball"><parent>base_footprint</parent><child>caster</child></joint>
    <link name="laser_link"><pose>0.08 0 0.14 0 0 0</pose><inertial><mass>0.08</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial><visual name="visual"><geometry><cylinder><radius>0.04</radius><length>0.04</length></cylinder></geometry></visual><sensor name="lidar" type="gpu_lidar"><always_on>true</always_on><visualize>false</visualize><update_rate>10</update_rate><topic>/scan</topic><gz_frame_id>laser_link</gz_frame_id><lidar><scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14159265359</min_angle><max_angle>3.14159265359</max_angle></horizontal></scan><range><min>0.10</min><max>12.0</max><resolution>0.01</resolution></range><noise><type>gaussian</type><mean>0.0</mean><stddev>0.005</stddev></noise></lidar></sensor></link>
    <joint name="laser_joint" type="fixed"><parent>base_footprint</parent><child>laser_link</child></joint>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive"><left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint><wheel_separation>0.26</wheel_separation><wheel_radius>0.033</wheel_radius><topic>/model/slam_robot/cmd_vel</topic><odom_topic>/model/slam_robot/odometry</odom_topic><tf_topic>/model/slam_robot/tf</tf_topic><frame_id>odom</frame_id><child_frame_id>base_footprint</child_frame_id><odom_publish_frequency>50</odom_publish_frequency><max_linear_velocity>0.60</max_linear_velocity><min_linear_velocity>-0.30</min_linear_velocity><max_angular_velocity>2.0</max_angular_velocity><min_angular_velocity>-2.0</min_angular_velocity><max_linear_acceleration>1.2</max_linear_acceleration><max_angular_acceleration>3.0</max_angular_acceleration></plugin>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher"><odom_frame>world</odom_frame><robot_base_frame>ground_truth_base</robot_base_frame><odom_publish_frequency>10</odom_publish_frequency><odom_topic>/model/slam_robot/ground_truth</odom_topic><tf_topic>/model/slam_robot/ground_truth_tf</tf_topic><dimensions>2</dimensions><gaussian_noise>0.0</gaussian_noise></plugin>
  </model>
</sdf>
